#!/bin/sh
# Builds fwnyq (AU-28): libnyquist (the upstream Nyquist 3.15 sources as vendored in libnyquist/) compiled from sources.txt
# with the upstream build's defines (CMTSTUFF, EXT), then the driver linked against it, libsndfile and portaudio.
# Needs a C and C++ compiler and libsndfile's and portaudio's development files. Output: ./fwnyq
set -e
here=$(cd "$(dirname "$0")" && pwd)
L="$here/libnyquist/nyquist"
build="$here/build"
mkdir -p "$build"
# the platform's system headers: sys/unix, or on Windows (MSYS2) the upstream 2.4.2 release's sys/win/msvc (switches.h defines
# WINDOWS for the shared headers); with them every source compiles under MinGW-w64, as checked by cross-compiling
case "$(uname -s)" in
  MINGW*|MSYS*) SYS="$L/sys/win/msvc $(pkg-config --cflags sndfile portaudio-2.0)" ;;
  *) SYS="$L/sys/unix" ;;
esac
INC="-I$here/libnyquist -I$L/cmt -I$L/cmupv/src -I$L/ffts/src -I$L/nyqsrc -I$L/nyqstk -I$L/nyqstk/include -I$L/tran -I$L/xlisp -I$SYS"
LIBS=""
# macOS: libsndfile and portaudio from Homebrew, and -fno-common as the upstream build uses on Darwin
if command -v brew >/dev/null 2>&1; then
  INC="$INC -I$(brew --prefix)/include"
  LIBS="-L$(brew --prefix)/lib"
fi
CXXLIB="-lstdc++"
if [ "$(uname)" = "Darwin" ]; then
  INC="$INC -fno-common"
  CXXLIB="-lc++"  # Apple's toolchain has libc++, not libstdc++
fi
objs=""
for s in $(grep -v '^#' "$here/sources.txt"); do
  o="$build/$(echo "$s" | tr '/' '_' | sed 's/\.cpp$/.o/;s/\.c$/.o/')"
  case "$s" in *.cpp) cc=${CXX:-c++} ;; *) cc=${CC:-cc} ;; esac
  extra=""
  # Apple's clang (and clang 16 on) refuses C's old implicit int, which three K&R definitions here use (midifile.c,
  # handlers.c): allowed again, they mean int as they always did. Implicit function declarations stay errors (they
  # truncate returned pointers); security.c's getcwd gets its prototype (it includes unistd.h only for __APPLE__ or UNIX)
  case "$s" in *.c) extra="-Wno-error=implicit-int" ;; esac
  case "$s" in */xlisp/security.c) extra="$extra -include unistd.h" ;; esac
  [ "$o" -nt "$here/libnyquist/$s" ] || $cc -O2 -fPIC -w -DCMTSTUFF -DEXT $INC $extra -c "$here/libnyquist/$s" -o "$o"
  objs="$objs $o"
done
ar rcs "$build/libnyquist.a" $objs
case "$(uname -s)" in
  # Windows: one self-contained .exe. MSYS2's pkg-config files leave out the system libraries a static link needs
  # (portaudio's declares none; FLAC's omits pthreads), found by cross-linking: named here
  MINGW*|MSYS*) LINK="-static $(pkg-config --static --libs sndfile portaudio-2.0) -lstdc++ -lpthread -lwinmm -lole32 -luuid -lsetupapi -lksuser -ldsound -lshlwapi" ;;
  *) LINK="$LIBS -lsndfile -lportaudio $CXXLIB" ;;
esac
${CC:-cc} -O2 -w "$here/fwnyq.c" -I"$here/libnyquist" $INC "$build/libnyquist.a" $LINK -lm -lpthread -o "$here/fwnyq"
echo "fwnyq built: $here/fwnyq"
