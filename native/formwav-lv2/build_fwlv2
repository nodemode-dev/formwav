#!/bin/sh
# Builds fwlv2 (AU-27): formwav's LV2 host, one C file, linked against lilv (the LV2 reference host library, ISC
# licence) and libsndfile. Needs their development files: on macOS brew install lilv libsndfile (pkg-config finds
# them), on Debian or Ubuntu apt install liblilv-dev libsndfile1-dev. Output: ./fwlv2
set -e
here=$(cd "$(dirname "$0")" && pwd)
if ! pkg-config --exists lilv-0 sndfile; then
  echo "fwlv2 needs lilv and libsndfile (macOS: brew install lilv libsndfile; Debian/Ubuntu: apt install liblilv-dev libsndfile1-dev)" >&2
  exit 1
fi
case "$(uname -s)" in
  # Windows: libsndfile (LGPL-2.1) and lilv, serd, sord, sratom and zix all dynamic, their DLLs (and what they load)
  # copied to dlls/ for the installer to place beside fwlv2.exe
  MINGW*|MSYS*)
    LINK="$(pkg-config --cflags --libs lilv-0 sndfile) -lpthread -lshlwapi -static-libgcc"
    ;;
  # macOS: room in the header for src-tauri/gather_macos_libs to point the libraries at the app's Frameworks
  Darwin) LINK="$(pkg-config --cflags --libs lilv-0 sndfile) -Wl,-headerpad_max_install_names" ;;
  *) LINK="$(pkg-config --cflags --libs lilv-0 sndfile)" ;;
esac
${CC:-cc} -O2 "$here/fwlv2.c" $LINK -lm -o "$here/fwlv2"
case "$(uname -s)" in
  MINGW*|MSYS*) mkdir -p "$here/dlls" && ldd "$here/fwlv2.exe" | awk '$3 ~ /^\/(mingw64|ucrt64|clang64)\// {print $3}' | while read -r dll; do cp "$dll" "$here/dlls/"; done ;;
esac
echo "fwlv2 built: $here/fwlv2"
