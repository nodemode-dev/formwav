#!/bin/sh
# Makes the macOS helpers self-contained: every library they load from outside macOS itself (Homebrew's libsndfile,
# portaudio, lilv and what those load in turn) is copied to FRAMEWORKS_DIR, which tauri.conf.json's frameworks (given
# by build_macos_app) places in formwav.app/Contents/Frameworks, and every reference to it, in the helpers and in the
# copies, is rewritten to @executable_path/../Frameworks/<name>, where Contents/MacOS/<helper> finds it. A hardened
# runtime app cannot load a library from /opt/homebrew, and the people who install formwav do not have Homebrew.
# The libraries stay separate shared libraries (libsndfile is LGPL-2.1: it stays replaceable).
# Each copy and each helper is signed again after the rewrite (install_name_tool voids a signature): with
# APPLE_SIGNING_IDENTITY, hardened runtime and a timestamp, otherwise ad hoc; Tauri signs them once more when it
# bundles. Then every file in BINARIES_DIR and every copy must load nothing from outside macOS and the app.
# Usage (from the repo root, on macOS): src-tauri/gather_macos_libs BINARIES_DIR FRAMEWORKS_DIR HELPER...
set -e
[ "$(uname)" = Darwin ] || { echo "gather_macos_libs runs on macOS only" >&2; exit 1; }
[ $# -ge 3 ] || { echo "usage: gather_macos_libs BINARIES_DIR FRAMEWORKS_DIR HELPER..." >&2; exit 1; }
bin_dir=$1
fw=$2
shift 2
# FRAMEWORKS_DIR sits beside BINARIES_DIR, as Contents/Frameworks sits beside Contents/MacOS, so the helpers load
# from it before bundling too (the load check below)
[ "$(cd "$bin_dir/.." && pwd -P)" = "$(mkdir -p "$fw" && cd "$fw/.." && pwd -P)" ] || {
  echo "FRAMEWORKS_DIR must sit beside BINARIES_DIR" >&2
  exit 1
}
[ "$(basename "$fw")" = Frameworks ] || { echo "FRAMEWORKS_DIR must be named Frameworks" >&2; exit 1; }
prefix=$(brew --prefix 2>/dev/null || echo /opt/homebrew)
ref="@executable_path/../Frameworks"
rm -rf "$fw"
mkdir -p "$fw"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
queue="$work/queue"
names="$work/names"
: > "$queue"
: > "$names"

own_id() { otool -D "$1" | tail -n +2; }
deps() { otool -L "$1" | tail -n +2 | awk '{print $1}'; }
rpaths() { otool -l "$1" | awk '$1 == "cmd" && $2 == "LC_RPATH" { getline; getline; print $2 }'; }
identity() { stat -L -f '%d:%i' "$1"; }

# where a reference found in ORIGINAL (the file as it was before copying) points
resolve() {
  dep=$1
  odir=$(cd "$(dirname "$2")" && pwd -P)
  cand=""
  case "$dep" in
    @loader_path/*) cand="$odir/${dep#@loader_path/}" ;;
    @rpath/*)
      for r in $(rpaths "$2") "$prefix/lib"; do
        case "$r" in
          @loader_path*) r="$odir${r#@loader_path}" ;;
          @*) continue ;;
        esac
        if [ -f "$r/${dep#@rpath/}" ]; then cand="$r/${dep#@rpath/}"; break; fi
      done
      ;;
    @*) ;;
    *) cand=$dep ;;
  esac
  if [ -z "$cand" ] || [ ! -f "$cand" ]; then
    echo "cannot find $dep, which $2 loads" >&2
    return 1
  fi
  echo "$cand"
}

sign() {
  if [ -n "${APPLE_SIGNING_IDENTITY:-}" ] &&
    codesign --force --timestamp --options runtime --sign "$APPLE_SIGNING_IDENTITY" "$1" 2>"$work/sign.err"; then
    return 0
  fi
  [ -n "${APPLE_SIGNING_IDENTITY:-}" ] && echo "note: $(basename "$1") signed ad hoc for now ($(cat "$work/sign.err")); Tauri signs it with the identity"
  codesign --force --sign - "$1"
}

for h in "$@"; do
  [ -f "$bin_dir/$h" ] || { echo "no helper $bin_dir/$h" >&2; exit 1; }
  printf '%s\t%s\n' "$bin_dir/$h" "$bin_dir/$h" >> "$queue"
done

i=1
while :; do
  line=$(awk -v n="$i" 'NR == n' "$queue")
  [ -n "$line" ] || break
  file=$(printf '%s' "$line" | cut -f1)
  orig=$(printf '%s' "$line" | cut -f2)
  id=$(own_id "$file")
  for dep in $(deps "$file"); do
    [ "$dep" = "$id" ] && continue
    case "$dep" in /usr/lib/*|/System/*|"$ref"/*) continue ;; esac
    src=$(resolve "$dep" "$orig") || exit 1
    name=$(basename "$dep")
    seen=$(awk -F '\t' -v n="$name" '$1 == n { print $2 }' "$names")
    if [ -z "$seen" ]; then
      cp -L "$src" "$fw/$name"
      chmod u+w "$fw/$name"
      install_name_tool -id "$ref/$name" "$fw/$name"
      printf '%s\t%s\n' "$name" "$(identity "$src")" >> "$names"
      printf '%s\t%s\n' "$fw/$name" "$src" >> "$queue"
      echo "bundled: $name (from $src)"
    elif [ "$seen" != "$(identity "$src")" ]; then
      echo "two different libraries are named $name (one is $src): stopping" >&2
      exit 1
    fi
    install_name_tool -change "$dep" "$ref/$name" "$file"
  done
  i=$((i + 1))
done

for lib in "$fw"/*.dylib; do
  [ -f "$lib" ] && sign "$lib"
done
for h in "$@"; do sign "$bin_dir/$h"; done

bad=0
for f in "$bin_dir"/* "$fw"/*.dylib; do
  [ -f "$f" ] || continue
  id=$(own_id "$f")
  for dep in $(deps "$f"); do
    [ "$dep" = "$id" ] && continue
    case "$dep" in
      /usr/lib/*|/System/*) ;;
      "$ref"/*) [ -f "$fw/${dep#"$ref"/}" ] || { echo "$f loads $dep, which is not bundled" >&2; bad=1; } ;;
      *) echo "$f still loads $dep from outside the app" >&2; bad=1 ;;
    esac
  done
done
[ "$bad" = 0 ] || exit 1

# each helper started with no arguments prints its usage; dyld refuses it first if a library is missing
for h in "$@"; do
  out=$("$bin_dir/$h" </dev/null 2>&1 >/dev/null || true)
  case "$out" in
    *"Library not loaded"*|*"image not found"*|*"code signature"*) echo "$h does not load: $out" >&2; exit 1 ;;
  esac
done
count=$(find "$fw" -name '*.dylib' | wc -l | tr -d ' ')
echo "helpers self-contained: $count libraries in $fw"
