{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "formwav",
  "version": "1.81.0",
  "identifier": "ai.nodemode.formwav",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/formwav-engine", "binaries/fwhost"],
    "category": "Music",
    "shortDescription": "Audio editor",
    "fileAssociations": [
      {
        "ext": ["fmw"],
        "name": "formwav session",
        "description": "A formwav session",
        "role": "Editor",
        "mimeType": "application/x-formwav-session"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
