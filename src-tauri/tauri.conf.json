{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormWav",
  "version": "2.22.1",
  "identifier": "ai.nodemode.formwav",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "splash",
        "title": "FormWav",
        "url": "splash.html",
        "width": 360,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/formwav-engine", "binaries/fwhost", "binaries/fwnyq", "binaries/fwvamp", "binaries/fwlv2"],
    "resources": { "../LICENSE": "LICENSE", "../NOTICE": "NOTICE", "../LICENSES.md": "LICENSES.md" },
    "category": "Music",
    "publisher": "NodeAgentc, Inc.",
    "copyright": "Copyright 2026 NodeAgentc, Inc. Apache-2.0",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "shortDescription": "Audio editor",
    "fileAssociations": [
      {
        "ext": ["fmw"],
        "name": "formwav session",
        "description": "A formwav session",
        "role": "Editor",
        "mimeType": "application/x-formwav-session"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": ["libsndfile1", "libportaudio2", "liblilv-0-0", "libasound2t64 | libasound2"],
        "recommends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good", "gstreamer1.0-libav"]
      },
      "rpm": {
        "depends": ["libsndfile", "portaudio", "lilv-libs", "alsa-lib"],
        "recommends": ["gstreamer1-plugins-base", "gstreamer1-plugins-good"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
