<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Merged by the Tauri CLI into the app's Info.plist. macOS refuses microphone access (and can end the app) for an
       app that does not say why it records: formwav records into its tracks. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>formwav records audio from your microphone or audio interface into its tracks.</string>
  <!-- macOS asks before an app talks to other devices on the network. formwav does only when the room or phone
       pairing is turned on in Settings; this is the reason shown then. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>FormWav uses your local network only when you turn on the room or phone pairing in Settings.</string>
</dict>
</plist>
