#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
# shellcheck disable=SC1091
source venv/bin/activate
if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi
# --reload-dir app: reload when the engine's source changes, not when pip or maturin write into venv/ (a reload during
# an install could fail to import and leave the engine down until the next edit)
exec uvicorn app.main:app --reload --reload-dir app --host "${HOST:-127.0.0.1}" --port "${FORMWAV_PORT:-8060}"
