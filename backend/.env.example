HOST=127.0.0.1
FORMWAV_PORT=8060
FORMWAV_CORS_ORIGINS=http://localhost:3060,http://127.0.0.1:3060,http://localhost:3061,http://127.0.0.1:3061
# The in-app agent (the Agent button): an Anthropic API key, kept here in the engine and never sent to the page.
# ANTHROPIC_API_KEY=
# FORMWAV_AGENT_MODEL=claude-sonnet-5-5
# Models (the Models section, the agent and the MCP server): keys stay here in the engine.
# ELEVENLABS_API_KEY=
# FAL_KEY=
# Open-weight models on this machine: copy backend/local_models.example.json to backend/models/local_models.json.
