#!/bin/sh
# Builds the formwav Linux desktop app: the Tauri shell (src-tauri) over the formwav engine frozen with PyInstaller,
# with its native helpers, packaged as a .deb. Run it ON Linux (Debian or Ubuntu; other distributions need the same
# libraries under their own names) from the repo root: ./build_linux_app
# It mirrors build_macos_app step for step; the differences are the system packages, the wheel left unrepaired (it is
# only for this machine's PyInstaller), and the bundle (a .deb; BUNDLES=deb,rpm,appimage adds an .rpm and an AppImage,
# and TARBALL=1 a .tar.gz of what the .deb installs, for any distribution: S18). It builds for this machine's own
# architecture, x86_64 or aarch64.
set -e
say() { printf '\n== %s ==\n' "$1"; }
BUNDLES=${BUNDLES:-deb}
TARBALL=${TARBALL:-0}
case ",$BUNDLES," in *,deb,*) ;; *) [ "$TARBALL" = 1 ] && BUNDLES="$BUNDLES,deb" ;; esac

say "Checking prerequisites"
command -v python3 >/dev/null || { echo "python3 is required: sudo apt install python3 python3-venv"; exit 1; }
python3 -m venv --help >/dev/null 2>&1 || { echo "python3's venv is required: sudo apt install python3-venv"; exit 1; }
command -v npm >/dev/null || { echo "npm is required (https://nodejs.org)"; exit 1; }
command -v cargo >/dev/null || { echo "Rust is required: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"; exit 1; }
rustup target list --installed 2>/dev/null | grep -qx wasm32-unknown-unknown || rustup target add wasm32-unknown-unknown
command -v pkg-config >/dev/null || { echo "pkg-config is required: sudo apt install pkg-config"; exit 1; }
# the shell's WebView and the native helpers' libraries (Nyquist and Vamp: libsndfile, portaudio; LV2: lilv; MIDI: ALSA)
for lib in webkit2gtk-4.1 gtk+-3.0 sndfile portaudio-2.0 lilv-0 alsa; do
  pkg-config --exists "$lib" || {
    echo "Missing $lib. On Debian or Ubuntu:"
    echo "  sudo apt install build-essential libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev libsndfile1-dev portaudio19-dev liblilv-dev libasound2-dev"
    exit 1
  }
done
# the Tauri CLI: cargo's if installed, else the npm package (prebuilt, no compile)
if cargo tauri --version >/dev/null 2>&1; then
  tauri() { cargo tauri "$@"; }
else
  tauri() { npx --yes @tauri-apps/cli@2.12.1 "$@"; }
fi
command -v ffmpeg >/dev/null || echo "Note: formwav reads and writes most formats through ffmpeg, which it finds on your PATH and never bundles: sudo apt install ffmpeg"
command -v rubberband >/dev/null || echo "Note: time-stretch and pitch features use the rubberband command on your PATH: sudo apt install rubberband-cli"

say "Building the interface"
cd frontend
# the page's audio core (WebAssembly) is built and placed in public/core by oc_install, which installs the packages too
./oc_install
npm run build
if [ ! -s dist/core/formwav_dsp.wasm ]; then
  echo "The interface was built without its audio core (dist/core/formwav_dsp.wasm): stopping." >&2
  exit 1
fi
echo "audio core: dist/core/formwav_dsp.wasm ($(wc -c < dist/core/formwav_dsp.wasm) bytes)"
cd ..

say "Building the engine (Python -> one binary)"
cd backend
python3 -m venv .venv-package
. .venv-package/bin/activate
pip install --upgrade pip >/dev/null
pip install -r requirements_desktop.txt
# python AND native (a --features flag replaces pyproject.toml's list); the wheel is not repaired for other machines
# (--skip-auditwheel): it is installed here for PyInstaller and nowhere else
rm -rf wheels && maturin build --release --skip-auditwheel -m ../native/formwav-dsp/Cargo.toml --features python,native -o wheels
pip install --force-reinstall wheels/*.whl
pyinstaller --clean --noconfirm --onefile --name formwav-engine \
  --collect-all uvicorn --collect-all formwav_dsp --collect-all app --collect-all keyring \
  --hidden-import app.main \
  --add-data "../frontend/dist:frontend_dist" \
  --add-data "../native/formwav-nyquist/runtime:nyquist_runtime" \
  desktop_entry.py
./dist/formwav-engine --selfcheck
deactivate
cd ..

say "Placing the engine and the helpers for this machine's target triple"
TRIPLE=$(rustc -Vv | awk '/^host:/ {print $2}')
mkdir -p src-tauri/binaries
cp backend/dist/formwav-engine "src-tauri/binaries/formwav-engine-$TRIPLE"
cargo build --release --manifest-path native/formwav-host/Cargo.toml
cp native/formwav-host/target/release/fwhost "src-tauri/binaries/fwhost-$TRIPLE"
native/formwav-nyquist/build_fwnyq
cp native/formwav-nyquist/fwnyq "src-tauri/binaries/fwnyq-$TRIPLE"
native/formwav-vamp/build_fwvamp
cp native/formwav-vamp/fwvamp "src-tauri/binaries/fwvamp-$TRIPLE"
native/formwav-lv2/build_fwlv2
cp native/formwav-lv2/fwlv2 "src-tauri/binaries/fwlv2-$TRIPLE"
ls -1 src-tauri/binaries | sed 's/^/sidecar: src-tauri\/binaries\//'

# the icons are committed in src-tauri/icons (regenerating them each build rewrote tracked files)

# formcompiler's Tauri settings (the updater) arrive as FORMCOMPILER_CONFIG_ARG, "--config FILE" or empty; the file
# path is kept whole, spaces and all
set --
case "${FORMCOMPILER_CONFIG_ARG:-}" in
  "") ;;
  "--config "*) set -- --config "${FORMCOMPILER_CONFIG_ARG#--config }" ;;
  *) echo "FORMCOMPILER_CONFIG_ARG must be --config FILE, not: $FORMCOMPILER_CONFIG_ARG" >&2; exit 1 ;;
esac

say "Building the app bundle (this compiles Rust; the first run takes a while)"
cd src-tauri
tauri build --bundles "$BUNDLES" "$@"
cd ..

if [ "$TARBALL" = 1 ]; then
  say "Packing the tarball (what the .deb installs, under usr/)"
  DEB=$(ls -1 src-tauri/target/release/bundle/deb/*.deb | head -1)
  STAGE=src-tauri/target/release/bundle/tar/stage
  rm -rf src-tauri/target/release/bundle/tar && mkdir -p "$STAGE"
  dpkg-deb -x "$DEB" "$STAGE"
  NAME=$(basename "$DEB" .deb)
  tar -czf "src-tauri/target/release/bundle/tar/$NAME.tar.gz" -C "$STAGE" usr
  rm -rf "$STAGE"
fi

say "Done"
find src-tauri/target/release/bundle -mindepth 2 -maxdepth 2 -type f 2>/dev/null | grep -E '\.(deb|rpm|AppImage|tar\.gz)$' | sort | sed 's/^/Package: /'
echo
echo "Install the .deb with: sudo apt install ./src-tauri/target/release/bundle/deb/<the .deb>"
echo "(an .rpm with sudo dnf install ./<the .rpm>; the .tar.gz unpacks to usr/bin/formwav and its helpers, anywhere)"
echo "Your media, sessions and keys live in ~/.local/share/ai.nodemode.formwav"
echo "(put ELEVENLABS_API_KEY, FAL_KEY or ANTHROPIC_API_KEY in a .env file there)."
