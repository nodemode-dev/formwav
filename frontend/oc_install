#!/usr/bin/env bash
set -e
cd "$(dirname "$0")"
npm install
if ! command -v cargo >/dev/null 2>&1; then
  echo "formwav needs Rust to build its audio core: install it from https://rustup.rs, then run this again." >&2
  exit 1
fi
rustup target add wasm32-unknown-unknown >/dev/null 2>&1 || true
cargo build --release --locked --target wasm32-unknown-unknown --lib --manifest-path ../native/formwav-dsp/Cargo.toml
mkdir -p public/core
cp ../native/formwav-dsp/target/wasm32-unknown-unknown/release/formwav_dsp.wasm public/core/formwav_dsp.wasm
