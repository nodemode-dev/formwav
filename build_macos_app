#!/bin/sh
# Builds the formwav macOS desktop app: the Tauri shell (src-tauri) over the formwav engine frozen with PyInstaller.
# Run it ON macOS from the repo root: ./build_macos_app
set -e

say() { printf '\n== %s ==\n' "$1"; }

say "Checking prerequisites"
command -v python3 >/dev/null || { echo "python3 is required (https://python.org)"; exit 1; }
command -v npm >/dev/null || { echo "npm is required (https://nodejs.org)"; exit 1; }
command -v cargo >/dev/null || { echo "Rust is required: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"; exit 1; }
xcode-select -p >/dev/null 2>&1 || { echo "Xcode command line tools are required: xcode-select --install"; exit 1; }
cargo tauri --version >/dev/null 2>&1 || { say "Installing tauri-cli"; cargo install tauri-cli --version '^2' --locked; }
command -v ffmpeg >/dev/null || echo "Note: formwav reads and writes most formats through ffmpeg, which it finds on your PATH and never bundles: brew install ffmpeg"
command -v rubberband >/dev/null || echo "Note: time-stretch and pitch features use the rubberband command on your PATH: brew install rubberband"
# the native helpers link Homebrew's libraries: libsndfile and portaudio (Nyquist, Vamp), lilv (LV2), found by pkg-config
command -v pkg-config >/dev/null || { echo "pkg-config is required to find the helpers' libraries: brew install pkgconf"; exit 1; }
for lib in sndfile portaudio-2.0 lilv-0; do
  pkg-config --exists "$lib" || { echo "The native helpers need $lib: brew install libsndfile portaudio lilv"; exit 1; }
done

say "Building the interface"
cd frontend
# the page's audio core (WebAssembly: playback, recording, the live instrument) is built and placed in public/core by
# oc_install, which installs the packages too; every desktop build up to v1.92.0 skipped it, and the app answered
# Record with "the audio core is missing (404)"
./oc_install
npm run build
if [ ! -s dist/core/formwav_dsp.wasm ]; then
  echo "The interface was built without its audio core (dist/core/formwav_dsp.wasm): stopping." >&2
  exit 1
fi
echo "audio core: dist/core/formwav_dsp.wasm ($(wc -c < dist/core/formwav_dsp.wasm) bytes)"
cd ..

say "Building the engine (Python -> one binary)"
cd backend
python3 -m venv .venv-package
. .venv-package/bin/activate
pip install --upgrade pip >/dev/null
pip install -r requirements_desktop.txt
# python AND native: a --features flag replaces pyproject.toml's list, and with python alone every desktop build up to
# v1.91.0 left out native audio output and MIDI input (the selfcheck below now fails without them)
rm -rf wheels && maturin build --release -m ../native/formwav-dsp/Cargo.toml --features python,native -o wheels
# --force-reinstall: at an unchanged version pip keeps the core already installed ("already installed with the same
# version"), so a rebuilt core would not reach the app (the owner's v1.93.0 log)
pip install --force-reinstall wheels/*.whl
pyinstaller --clean --noconfirm --onefile --name formwav-engine \
  --collect-all uvicorn --collect-all formwav_dsp --collect-all app \
  --hidden-import app.main \
  --add-data "../frontend/dist:frontend_dist" \
  --add-data "../native/formwav-nyquist/runtime:nyquist_runtime" \
  --add-data "../native/formwav-nyquist/plug-ins:nyquist_plugins" \
  desktop_entry.py
./dist/formwav-engine --selfcheck
deactivate
cd ..

say "Placing the engine for this machine's target triple"
TRIPLE=$(rustc -Vv | awk '/^host:/ {print $2}')
mkdir -p src-tauri/binaries
cp backend/dist/formwav-engine "src-tauri/binaries/formwav-engine-$TRIPLE"
echo "sidecar: src-tauri/binaries/formwav-engine-$TRIPLE"
# The plugin host runs beside the engine (one process per plugin job); the shell tells the engine where it is.
cargo build --release --manifest-path native/formwav-host/Cargo.toml
cp native/formwav-host/target/release/fwhost "src-tauri/binaries/fwhost-$TRIPLE"
echo "sidecar: src-tauri/binaries/fwhost-$TRIPLE"
# AU-28: Nyquist's runner (Audacity's libnyquist, vendored); it needs libsndfile and portaudio (brew install libsndfile
# portaudio), linked from Homebrew, so this app runs on Macs that have them
native/formwav-nyquist/build_fwnyq
cp native/formwav-nyquist/fwnyq "src-tauri/binaries/fwnyq-$TRIPLE"
echo "sidecar: src-tauri/binaries/fwnyq-$TRIPLE"
# AU-40: the Vamp host (the Vamp SDK's host library, vendored); plugins are found in ~/Library/Audio/Plug-Ins/Vamp and
# /Library/Audio/Plug-Ins/Vamp, or VAMP_PATH
native/formwav-vamp/build_fwvamp
cp native/formwav-vamp/fwvamp "src-tauri/binaries/fwvamp-$TRIPLE"
echo "sidecar: src-tauri/binaries/fwvamp-$TRIPLE"
# AU-27: the LV2 host (lilv); plugins are found in ~/Library/Audio/Plug-Ins/LV2 and /Library/Audio/Plug-Ins/LV2, or LV2_PATH
native/formwav-lv2/build_fwlv2
cp native/formwav-lv2/fwlv2 "src-tauri/binaries/fwlv2-$TRIPLE"
echo "sidecar: src-tauri/binaries/fwlv2-$TRIPLE"

# the icons are committed in src-tauri/icons (regenerating them each build rewrote tracked files)

say "Building the app bundle (this compiles Rust; the first run takes a while)"
cd src-tauri
cargo tauri build
cd ..

say "Done"
echo "App:  src-tauri/target/release/bundle/macos/formwav.app"
echo "DMG:  src-tauri/target/release/bundle/dmg/"
echo
echo "The bundle is unsigned. First launch: right-click the app > Open,"
echo "or clear quarantine: xattr -dr com.apple.quarantine src-tauri/target/release/bundle/macos/formwav.app"
echo
echo "Your media, sessions and keys live in ~/Library/Application Support/ai.nodemode.formwav"
echo "(put ELEVENLABS_API_KEY, FAL_KEY or ANTHROPIC_API_KEY in a .env file there)."
echo
echo "Intel Macs: run this same script on an Intel machine, or add the target"
echo "(rustup target add x86_64-apple-darwin) and rebuild the engine there."
