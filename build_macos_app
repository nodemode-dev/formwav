#!/bin/sh
# Builds the formwav macOS desktop app: the Tauri shell (src-tauri) over the formwav engine frozen with PyInstaller.
# Run it ON macOS from the repo root: ./build_macos_app
set -e

say() { printf '\n== %s ==\n' "$1"; }

say "Checking prerequisites"
command -v python3 >/dev/null || { echo "python3 is required (https://python.org)"; exit 1; }
command -v npm >/dev/null || { echo "npm is required (https://nodejs.org)"; exit 1; }
command -v cargo >/dev/null || { echo "Rust is required: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"; exit 1; }
xcode-select -p >/dev/null 2>&1 || { echo "Xcode command line tools are required: xcode-select --install"; exit 1; }
cargo tauri --version >/dev/null 2>&1 || { say "Installing tauri-cli"; cargo install tauri-cli --version '^2' --locked; }
command -v ffmpeg >/dev/null || echo "Note: formwav reads and writes most formats through ffmpeg, which it finds on your PATH and never bundles: brew install ffmpeg"
command -v rubberband >/dev/null || echo "Note: time-stretch and pitch features use the rubberband command on your PATH: brew install rubberband"

say "Building the interface"
cd frontend
[ -d node_modules ] || npm install
npm run build
cd ..

say "Building the engine (Python -> one binary)"
cd backend
python3 -m venv .venv-package
. .venv-package/bin/activate
pip install --upgrade pip >/dev/null
pip install -r requirements_desktop.txt
rm -rf wheels && maturin build --release -m ../native/formwav-dsp/Cargo.toml --features python -o wheels
pip install wheels/*.whl
pyinstaller --clean --noconfirm --onefile --name formwav-engine \
  --collect-all uvicorn --collect-all formwav_dsp --collect-all app \
  --hidden-import app.main \
  --add-data "../frontend/dist:frontend_dist" \
  desktop_entry.py
./dist/formwav-engine --selfcheck
deactivate
cd ..

say "Placing the engine for this machine's target triple"
TRIPLE=$(rustc -Vv | awk '/^host:/ {print $2}')
mkdir -p src-tauri/binaries
cp backend/dist/formwav-engine "src-tauri/binaries/formwav-engine-$TRIPLE"
echo "sidecar: src-tauri/binaries/formwav-engine-$TRIPLE"
# The plugin host runs beside the engine (one process per plugin job); the shell tells the engine where it is.
cargo build --release --manifest-path native/formwav-host/Cargo.toml
cp native/formwav-host/target/release/fwhost "src-tauri/binaries/fwhost-$TRIPLE"
echo "sidecar: src-tauri/binaries/fwhost-$TRIPLE"

say "Generating app icons"
cargo tauri icon src-tauri/icons/icon.png

say "Building the app bundle (this compiles Rust; the first run takes a while)"
cd src-tauri
cargo tauri build
cd ..

say "Done"
echo "App:  src-tauri/target/release/bundle/macos/formwav.app"
echo "DMG:  src-tauri/target/release/bundle/dmg/"
echo
echo "The bundle is unsigned. First launch: right-click the app > Open,"
echo "or clear quarantine: xattr -dr com.apple.quarantine src-tauri/target/release/bundle/macos/formwav.app"
echo
echo "Your media, sessions and keys live in ~/Library/Application Support/ai.nodemode.formwav"
echo "(put ELEVENLABS_API_KEY, FAL_KEY or ANTHROPIC_API_KEY in a .env file there)."
echo
echo "Intel Macs: run this same script on an Intel machine, or add the target"
echo "(rustup target add x86_64-apple-darwin) and rebuild the engine there."
